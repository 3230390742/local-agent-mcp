# local-agent-mcp environment configuration
# Copy this file to `.env` (or set these variables in your MCP client config).
# All variables are read once at server startup.

# REQUIRED: Comma-separated list of ABSOLUTE directories the agents may access.
# Any working directory passed to a tool must resolve (after symlink
# resolution) to a path inside one of these roots. An empty value means NO
# directory is permitted and every tool call requiring a cwd is rejected.
#
# Windows example:
#   AGENT_ALLOWED_ROOTS=C:\Users\me\projects,C:\work
# macOS / Linux example:
#   AGENT_ALLOWED_ROOTS=/Users/me/projects,/home/me/work
AGENT_ALLOWED_ROOTS=

# Allow write-capable runs. When false (default), codex_run workspace_write and
# opencode_run auto_approve are rejected. Set to "true" to permit writes.
AGENT_ALLOW_WRITE=false

# Maximum combined bytes of stdout+stderr captured per child process.
# Output beyond this is dropped and the result is marked truncated.
# Default: 5000000 (5 MB)
AGENT_MAX_OUTPUT_BYTES=5000000

# Maximum number of concurrent agent runs across all tools.
# Default: 3
AGENT_MAX_CONCURRENCY=3

# When "true", full prompts are written to the stderr debug log.
# Leave false in normal use to avoid logging prompt contents.
AGENT_DEBUG=false
